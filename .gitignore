# Android Studio / IntelliJ: общие конфигурации запуска храним в git,
# остальное (рабочее место, кэш индексов) — нет.
.idea/*
!.idea/runConfigurations/
.vscode/

# Ключи сборки (--dart-define-from-file): только локально
config/dart_defines.json
!.vscode/extensions.json

# Logs
*.log
logs/

# Secrets — NEVER commit
*.keystore
*.jks
key.properties
key.properties.bak-*
**/google-services.json
**/GoogleService-Info.plist

# TLS-сертификаты и ключи (секреты — не коммитить)
server/**/ssl/
*.p8
*_key.pem
privkey.pem

# Секреты OAuth-прокси — только на сервере, не в репозитории
.env
server/**/.env
!.env.example
# Файлы со значениями переменных окружения (секреты)
ENV_VALUES.txt
server/**/ENV_VALUES.txt
# Секреты сборки приложения
scripts/.env.build
!scripts/.env.build.example

# Скачанный сборочным скриптом nuget.exe
tools/

# Python
__pycache__/
*.pyc
tool/shots/out/
# Копия файла проекта Xcode до scripts/ios_localizations.py (1.8.0)
ios/Runner.xcodeproj/project.pbxproj.bak
__pycache__/
*.pyc
config/dart_defines.json
site/

# Код drift (build_runner) и lock-файл: CI создаёт их сам
*.g.dart
pubspec.lock
