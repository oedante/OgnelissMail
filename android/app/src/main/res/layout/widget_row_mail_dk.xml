<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tool/dev/widget_themes.py — не править вручную. -->
<!-- Строка письма: метка цвета ящика · отправитель и время · тема · строка
     текста (08.11.2026) · «Прочитано» и «В архив» справа — значок с
     подписью. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ml_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">
    <ImageView
        android:id="@+id/ml_bar"
        style="@style/WidgetBarDk" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ml_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_text_dk"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ml_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="@color/widget_sub_dk"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/ml_subj" style="@style/WidgetRowSubDk" android:textSize="13sp" />
        <TextView
            android:id="@+id/ml_prev"
            style="@style/WidgetRowSubDk"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- Кнопки — значок с подписью (21.11.2026, замечание владельца:
         «кнопки непонятные» — были только значки). -->
    <LinearLayout
        android:id="@+id/ml_read"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/ml_read_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_done_dk" />
        <TextView
            android:id="@+id/ml_read_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_sub_dk"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ml_archive"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/ml_archive_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_archive_dk" />
        <TextView
            android:id="@+id/ml_archive_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_sub_dk"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
