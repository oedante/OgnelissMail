<?xml version="1.0" encoding="utf-8"?>
<!-- Строка встречи или задачи: колонка времени 52 dp · метка цвета ·
     название и подпись (место). Встреча на весь день — значок вместо
     времени (ev_allday, 1.10.2): надпись «Весь день» в колонку не помещалась.
     У задачи в «Моём дне» справа — галочка «Выполнено» (ev_done). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ev_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/ev_allday"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_ic_allday"
            android:visibility="gone" />
        <TextView
            android:id="@+id/ev_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ev_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/widget_sub"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
    <ImageView
        android:id="@+id/ev_bar"
        style="@style/WidgetBar" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/ev_title" style="@style/WidgetRowTitle" />
        <TextView android:id="@+id/ev_sub" style="@style/WidgetRowSub" android:visibility="gone" />
    </LinearLayout>
    <!-- Галочка «Выполнено» у задачи в «Моём дне» (08.11.2026, план п. 8.2). -->
    <ImageView
        android:id="@+id/ev_done"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ic_done"
        android:visibility="gone" />
</LinearLayout>
