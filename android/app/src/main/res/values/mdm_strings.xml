<?xml version="1.0" encoding="utf-8"?>
<!-- Подписи управляемых настроек в консолях MDM (1.10.5): английский — для остальных языков. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="mdm_org_name_title">Organization name</string>
    <string name="mdm_org_name_desc">Shown in Settings → Managed by your organization.</string>
    <string name="mdm_support_contact_title">IT support contact</string>
    <string name="mdm_support_contact_desc">Phone, email or link shown to the user.</string>
    <string name="mdm_account_email_title">Mailbox address</string>
    <string name="mdm_account_email_desc">Pre-fills sign-in with this address.</string>
    <string name="mdm_account_protocol_title">Mailbox protocol</string>
    <string name="mdm_account_protocol_desc">auto, exchange (ActiveSync or EWS, chosen by the app) or imap.</string>
    <string name="mdm_account_server_title">Exchange server</string>
    <string name="mdm_account_server_desc">Host or URL of the Exchange server.</string>
    <string name="mdm_account_username_title">User name</string>
    <string name="mdm_account_username_desc">Sign-in name if it differs from the address.</string>
    <string name="mdm_account_domain_title">Domain</string>
    <string name="mdm_account_domain_desc">Windows domain for Exchange sign-in.</string>
    <string name="mdm_imap_server_title">IMAP server</string>
    <string name="mdm_imap_server_desc">IMAP host for protocol imap.</string>
    <string name="mdm_imap_port_title">IMAP port</string>
    <string name="mdm_imap_port_desc">Usually 993.</string>
    <string name="mdm_smtp_server_title">SMTP server</string>
    <string name="mdm_smtp_server_desc">SMTP host for protocol imap.</string>
    <string name="mdm_smtp_port_title">SMTP port</string>
    <string name="mdm_smtp_port_desc">Usually 465 or 587.</string>
    <string name="mdm_allowed_domains_title">Allowed mailbox domains</string>
    <string name="mdm_allowed_domains_desc">Comma-separated; other mailboxes cannot be added. Empty — any.</string>
    <string name="mdm_require_app_lock_title">Require app PIN</string>
    <string name="mdm_require_app_lock_desc">The app cannot be used without a PIN.</string>
    <string name="mdm_min_pin_length_title">Minimum PIN length</string>
    <string name="mdm_min_pin_length_desc">4 to 6 digits.</string>
    <string name="mdm_block_screenshots_title">Block screenshots</string>
    <string name="mdm_block_screenshots_desc">Screenshots, screen recording and app preview in Recents.</string>
    <string name="mdm_block_share_title">Block sharing and saving</string>
    <string name="mdm_block_share_desc">Share, save to files, PDF export and printing.</string>
    <string name="mdm_block_open_in_title">Block opening in other apps</string>
    <string name="mdm_block_open_in_desc">Attachments open only inside the app.</string>
    <string name="mdm_block_copy_title">Block copying message text</string>
    <string name="mdm_block_copy_desc">Text selection and Copy in messages.</string>
    <string name="mdm_hide_notification_content_title">Hide notification content</string>
    <string name="mdm_hide_notification_content_desc">Notifications show no sender, subject or text.</string>
    <string name="mdm_block_weather_title">Block weather</string>
    <string name="mdm_block_weather_desc">No weather in My Day: the app does not contact the weather (MET Norway) and city search (OpenStreetMap) services.</string>
    <string-array name="mdm_protocol_entries">
        <item>Automatic</item>
        <item>Microsoft Exchange</item>
        <item>IMAP</item>
    </string-array>
    <string-array name="mdm_protocol_values" translatable="false">
        <item>auto</item>
        <item>exchange</item>
        <item>imap</item>
    </string-array>
    <string name="mdm_max_sync_days_title">Maximum mail period, days</string>
    <string name="mdm_max_sync_days_desc">Mail older than this is not kept on the device; mailboxes set to "all mail" or a longer period get this one. 0 — no limit.</string>
    <string name="mdm_block_attachment_download_title">Block attachments on the device</string>
    <string name="mdm_block_attachment_download_desc">Attachments cannot be opened, saved, dragged out or shared. Forwarding messages with attachments still works.</string>
    <string name="mdm_pin_timeout_minutes_title">Lock after inactivity, minutes</string>
    <string name="mdm_pin_timeout_minutes_desc">The app locks with its PIN after this many minutes without use (1–60); the shorter of this and the Exchange policy applies. 0 — not set.</string>
    <string name="mdm_allow_biometrics_title">Allow fingerprint and face unlock</string>
    <string name="mdm_allow_biometrics_desc">Off — the app is unlocked only with its PIN.</string>
    <string name="mdm_block_external_services_title">Block external services</string>
    <string name="mdm_block_external_services_desc">No weather, no sender logos (BIMI) and no new-mail signals through the Ogneliss server: new mail arrives by the connection to the mail server and scheduled checks.</string>
    <string name="mdm_account_locked_title">Lock the organization's mailbox</string>
    <string name="mdm_account_locked_desc">The mailbox from these settings cannot be removed, and its server and sign-in cannot be changed.</string>
    <string name="mdm_account_transport_title">Exchange connection protocol</string>
    <string name="mdm_account_transport_desc">ActiveSync or EWS for on-premises Exchange; automatic — the app chooses. Exchange Online with Microsoft sign-in is not affected.</string>
    <string-array name="mdm_transport_entries">
        <item>Automatic</item>
        <item>ActiveSync</item>
        <item>EWS</item>
    </string-array>
    <string-array name="mdm_transport_values" translatable="false">
        <item>auto</item>
        <item>eas</item>
        <item>ews</item>
    </string-array>
    <string name="mdm_require_tls_title">Encrypted connections only</string>
    <string name="mdm_require_tls_desc">IMAP and SMTP without SSL or STARTTLS are refused.</string>
    <string name="mdm_trusted_ca_pem_title">Organization root certificates (PEM)</string>
    <string name="mdm_trusted_ca_pem_desc">One or more CA certificates in PEM format; servers signed by them are trusted.</string>
    <string name="mdm_allow_user_cert_trust_title">Allow users to trust certificates</string>
    <string name="mdm_allow_user_cert_trust_desc">Off — no importing CA certificates, no trusting a server's certificate by hand and no device-installed certificates; only system and organization certificates are used.</string>
    <string name="mdm_block_device_contacts_title">Block copying contacts to the device</string>
    <string name="mdm_block_device_contacts_desc">No import from and export to the device's Contacts app.</string>
    <string name="mdm_block_device_calendar_title">Block copying events to the device</string>
    <string name="mdm_block_device_calendar_desc">Events are not added to the device's Calendar app.</string>
</resources>
