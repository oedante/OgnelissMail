# ─── Ogneliss OAuth Proxy — пример конфигурации ───
# Обычно .env создаёт install-oauth-proxy.sh (секреты генерирует сам).
# Вручную: скопируйте в .env и заполните. Права 600, в git не добавлять.
# Значения без кавычек: Docker (env_file) воспринимает кавычки буквально.

# Внешний HTTPS-адрес прокси (должен совпадать с redirect_uri в консолях провайдеров):
#   <BASE_URL>/oauth/callback
# ВАЖНО: Google и Microsoft НЕ принимают голый IP как redirect_uri — нужен домен с
# валидным TLS. Для IP-сервера (217.114.43.126) с self-signed сертификатом реально
# работают провайдеры, допускающие IP/самоподписанные (напр. корпоративные/Яндекс),
# либо повесьте домен на IP и выпустите Let's Encrypt.
BASE_URL=https://www.ogneliss.ru/oauth

# Порт локального процесса (за nginx). По умолчанию 8787.
PORT=8787

# Общий ключ приложение↔прокси (заголовок x-api-key для POST /token). openssl rand -hex 32
PROXY_API_KEY=

# Секрет подписи state (CSRF-защита). openssl rand -hex 32
STATE_SECRET=

# Секрет шифрования refresh-blob rt (AES-256-GCM). ОБЯЗАТЕЛЬНО задать (иначе берётся
# STATE_SECRET). openssl rand -hex 32. При смене — все сохранённые rt станут недействительны.
ENC_SECRET=

# Разрешённые адреса возврата в приложение (защита от open-redirect), через запятую.
ALLOWED_REDIRECTS=com.ogneliss.mail://oauth,com.ogneliss.mail:/oauth2redirect

# ─── Провайдеры (секреты только здесь, не в приложении) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPE=https://mail.google.com/ https://www.googleapis.com/auth/gmail.settings.basic https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/carddav openid email profile

# Microsoft (Outlook/Office365 через EWS). Регистрация: Azure Portal → App registrations.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# По умолчанию — IMAP/SMTP Outlook.com и Office 365 (см. server.js). Задавать,
# только если нужен EWS Exchange Online:
#MS_SCOPE=https://outlook.office.com/EWS.AccessAsUser.All offline_access openid email profile

# Exchange Online (Microsoft 365) по ActiveSync и Microsoft Graph (1.8.11).
# По умолчанию — тот же клиент, что MS_CLIENT_ID/MS_CLIENT_SECRET: в его
# «API permissions» должны быть Office 365 Exchange Online → EAS.AccessAsUser.All,
# EWS.AccessAsUser.All и права Microsoft Graph (User.Read, User.ReadBasic.All,
# People.Read, Mail.ReadWrite, MailboxSettings.ReadWrite), тип учётных
# записей — «любой каталог организации (и личные учётные записи)», адрес
# возврата (Web) — <BASE_URL>/callback. Отдельный клиент — задайте здесь.
#EXO_CLIENT_ID=
#EXO_CLIENT_SECRET=
# EXO_GRAPH=0 — не просить при входе согласие на Microsoft Graph (только ActiveSync/EWS).
#EXO_GRAPH=1

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# По умолчанию: почта, календарь, адресная книга и профиль (login:email,
# login:info — адрес Яндекс 360 на своём домене). Отметьте эти права в
# приложении на oauth.yandex.ru. Если какие-то не отмечены, Яндекс отвечает
# invalid_scope — прокси повторит вход без профиля, затем только с почтой.
#YANDEX_SCOPE=mail:imap_full mail:smtp calendar:all addressbook:all login:email login:info
#YANDEX_BASE_SCOPE=mail:imap_full mail:smtp

MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_SCOPE=openid email profile mail.imap offline_access

# Yahoo. Регистрация: Yahoo Developer → приложение. Consumer Key = client_id,
# Consumer Secret = client_secret. Scope зависит от выданных прав (Mail).
YAHOO_APP_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# mail-w обязателен (IMAP/SMTP). Права в Yahoo Developer: Mail → Read/Write,
# OpenID Connect → Email, Profile. При invalid_scope прокси повторит вход
# с «openid mail-w», затем «mail-w».
#YAHOO_SCOPE=openid email profile mail-w
