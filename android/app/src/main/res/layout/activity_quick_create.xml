<?xml version="1.0" encoding="utf-8"?>
<!-- Окно «Создать» виджета «Календарь» (QuickCreateActivity): встреча или
     задача без входа в приложение. Сетка как у виджетов: поля 24 dp, поля
     ввода 48 dp, отступы 12–16 dp. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/qc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/qc_kind"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:padding="3dp"
            android:background="@drawable/widget_tabs_bg">
            <RadioButton
                android:id="@+id/qc_event"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/qc_seg_bg"
                android:gravity="center"
                android:checked="true"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
            <RadioButton
                android:id="@+id/qc_task"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/qc_seg_bg"
                android:gravity="center"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/qc_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/qc_field_bg"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
            android:layout_marginTop="16dp"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences" />

        <TextView
            android:id="@+id/qc_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="14dp"
            android:textColor="#C0392B"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/qc_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/qc_field_bg"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/qc_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qc_start"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/qc_field_bg"
                android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
                android:layout_weight="1"
                android:gravity="center" />
            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="–"
                android:textColor="@color/widget_sub"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/qc_end"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/qc_field_bg"
                android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
                android:layout_weight="1"
                android:gravity="center" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/qc_allday"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/qc_nodate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/qc_remind_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <CheckBox
                android:id="@+id/qc_remind"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/qc_rem_time"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="@drawable/qc_field_bg"
                android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/qc_account_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/widget_sub"
            android:textSize="12sp"
            android:visibility="gone" />
        <Spinner
            android:id="@+id/qc_account"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/qc_field_bg"
            android:paddingStart="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/qc_cancel"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:textAllCaps="false"
                android:textColor="@color/widget_accent"
                android:textSize="15sp" />
            <Button
                android:id="@+id/qc_create"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="112dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/widget_badge_bg"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
