# ─────────────────────────────────────────────────────────────────────────────
# Секреты СБОРКИ приложения. Скопируйте в scripts/.env.build и заполните.
#   cp scripts/.env.build.example scripts/.env.build
# Файл scripts/.env.build в .gitignore — в репозиторий НЕ попадает.
# Значения подставляются как --dart-define при сборке (scripts/setup.sh).
# ─────────────────────────────────────────────────────────────────────────────

# Адрес OAuth-прокси. Режим «путь на домене» (рекомендуется):
OAUTH_PROXY_URL=https://www.ogneliss.ru/oauth

# Ключ API прокси — печатается установщиком, лежит в PROXY_API_KEY на сервере:
#   grep '^PROXY_API_KEY=' /opt/mailserver/oauth-proxy/.env
OAUTH_PROXY_KEY=

# ─── Легаси (без прокси) ─────────────────────────────────────────────────────
# Нужен ТОЛЬКО если собираете без OAUTH_PROXY_URL и хотите Mail.ru.
# Штатный путь — прокси: секрет остаётся на сервере и в APK не попадает.
# MAILRU_CLIENT_SECRET=
