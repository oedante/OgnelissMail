<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Манифест конфиденциальности расширения виджетов (1.7.0). Виджеты ничего
     не собирают и никуда не передают: читают JSON, который приложение
     кладёт в общий контейнер App Group «group.com.ogneliss.mail», и хранят
     там же выбранный день виджета «Календарь: месяц».
     API «с обязательной причиной»:
       UserDefaults 1C8F.1 — чтение и запись в UserDefaults своей App Group. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
