<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tool/dev/widget_themes.py — не править вручную. -->
<!-- Виджет «Задачи» (TasksWidget, 08.11.2026, план п. 8.4): открытые
     задачи карточкой (widget_row_task) с галочкой «Выполнено»; «+» — новая
     задача (окно «Создать» в режиме задачи). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    style="@style/WidgetRootLt">
    <LinearLayout style="@style/WidgetHeaderLt">
        <LinearLayout
            android:id="@+id/tk_head"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tk_title"
                    style="@style/WidgetTitleLt"
                    android:text="@string/widget_tasks_label" />
                <TextView
                    android:id="@+id/tk_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="20dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/widget_badge_bg_lt"
                    android:textColor="@color/widget_on_accent_lt"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/tk_sub"
                style="@style/WidgetSubtitleLt"
                android:visibility="gone" />
        </LinearLayout>
        <ImageView
            android:id="@+id/tk_action"
            style="@style/WidgetHeadButtonLt"
            android:src="@drawable/widget_ic_add_lt"
            android:contentDescription="@string/widget_task_new" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tk_list"
        style="@style/WidgetCardLt" />
</LinearLayout>
