<?xml version="1.0" encoding="utf-8"?>
<!-- Подписи управляемых настроек в консолях MDM (1.10.5): русский. -->
<resources>
    <string name="mdm_org_name_title">Название организации</string>
    <string name="mdm_org_name_desc">Показывается в «Настройки → Управляется организацией».</string>
    <string name="mdm_support_contact_title">Контакт ИТ-поддержки</string>
    <string name="mdm_support_contact_desc">Телефон, почта или ссылка — показывается пользователю.</string>
    <string name="mdm_account_email_title">Адрес ящика</string>
    <string name="mdm_account_email_desc">Вход заполняется этим адресом.</string>
    <string name="mdm_account_protocol_title">Протокол ящика</string>
    <string name="mdm_account_protocol_desc">auto, exchange (ActiveSync или EWS — выбирает приложение) или imap.</string>
    <string name="mdm_account_server_title">Сервер Exchange</string>
    <string name="mdm_account_server_desc">Адрес или URL сервера Exchange.</string>
    <string name="mdm_account_username_title">Имя пользователя</string>
    <string name="mdm_account_username_desc">Имя для входа, если не совпадает с адресом.</string>
    <string name="mdm_account_domain_title">Домен</string>
    <string name="mdm_account_domain_desc">Домен Windows для входа в Exchange.</string>
    <string name="mdm_imap_server_title">Сервер IMAP</string>
    <string name="mdm_imap_server_desc">Сервер IMAP для протокола imap.</string>
    <string name="mdm_imap_port_title">Порт IMAP</string>
    <string name="mdm_imap_port_desc">Обычно 993.</string>
    <string name="mdm_smtp_server_title">Сервер SMTP</string>
    <string name="mdm_smtp_server_desc">Сервер SMTP для протокола imap.</string>
    <string name="mdm_smtp_port_title">Порт SMTP</string>
    <string name="mdm_smtp_port_desc">Обычно 465 или 587.</string>
    <string name="mdm_allowed_domains_title">Разрешённые домены ящиков</string>
    <string name="mdm_allowed_domains_desc">Через запятую; другие ящики добавить нельзя. Пусто — любые.</string>
    <string name="mdm_require_app_lock_title">Обязательный код приложения</string>
    <string name="mdm_require_app_lock_desc">Без кода приложением пользоваться нельзя.</string>
    <string name="mdm_min_pin_length_title">Минимальная длина кода</string>
    <string name="mdm_min_pin_length_desc">От 4 до 6 цифр.</string>
    <string name="mdm_block_screenshots_title">Запрет снимков экрана</string>
    <string name="mdm_block_screenshots_desc">Снимки и запись экрана, миниатюра в «Недавних».</string>
    <string name="mdm_block_share_title">Запрет «Поделиться» и сохранения</string>
    <string name="mdm_block_share_desc">«Поделиться», сохранение в файлы, PDF и печать.</string>
    <string name="mdm_block_open_in_title">Запрет открытия в других приложениях</string>
    <string name="mdm_block_open_in_desc">Вложения открываются только внутри приложения.</string>
    <string name="mdm_block_copy_title">Запрет копирования текста писем</string>
    <string name="mdm_block_copy_desc">Выделение текста и «Копировать» в письмах.</string>
    <string name="mdm_hide_notification_content_title">Уведомления без содержимого</string>
    <string name="mdm_hide_notification_content_desc">В уведомлениях нет отправителя, темы и текста.</string>
    <string name="mdm_block_weather_title">Запретить погоду</string>
    <string name="mdm_block_weather_desc">В «Моём дне» нет погоды: приложение не обращается к сервисам погоды (MET Norway) и поиска города (OpenStreetMap).</string>
    <string-array name="mdm_protocol_entries">
        <item>Автоматически</item>
        <item>Microsoft Exchange</item>
        <item>IMAP</item>
    </string-array>
    <string name="mdm_max_sync_days_title">Почта на устройстве, не больше дней</string>
    <string name="mdm_max_sync_days_desc">Письма старше не хранятся на устройстве; ящики с периодом «вся почта» или длиннее получают этот. 0 — без предела.</string>
    <string name="mdm_block_attachment_download_title">Запретить вложения на устройстве</string>
    <string name="mdm_block_attachment_download_desc">Вложения нельзя открыть, сохранить, перетащить или отправить в другое приложение. Пересылать письма с вложениями можно.</string>
    <string name="mdm_pin_timeout_minutes_title">Блокировка после бездействия, минут</string>
    <string name="mdm_pin_timeout_minutes_desc">Приложение закрывается PIN-кодом через столько минут без работы (1–60); действует меньшее из этого и политики Exchange. 0 — не задано.</string>
    <string name="mdm_allow_biometrics_title">Разрешить вход по отпечатку и лицу</string>
    <string name="mdm_allow_biometrics_desc">Выключено — приложение открывается только PIN-кодом.</string>
    <string name="mdm_block_external_services_title">Запретить внешние службы</string>
    <string name="mdm_block_external_services_desc">Без погоды, логотипов отправителей (BIMI), сигналов о новой почте и входа через сервер Ogneliss: почта приходит по соединению с сервером почты и плановым проверкам; ящики со входом через сервер Ogneliss добавляются паролем приложения.</string>
    <string name="mdm_account_locked_title">Закрепить ящик организации</string>
    <string name="mdm_account_locked_desc">Ящик из этих настроек нельзя удалить, нельзя изменить его сервер и вход.</string>
    <string name="mdm_account_transport_title">Протокол подключения к Exchange</string>
    <string name="mdm_account_transport_desc">ActiveSync или EWS для своего сервера Exchange; «Автоматически» — выбирает приложение. Exchange Online со входом Microsoft не затрагивается.</string>
    <string-array name="mdm_transport_entries">
        <item>Автоматически</item>
        <item>ActiveSync</item>
        <item>EWS</item>
    </string-array>
    <string name="mdm_require_tls_title">Только шифрованные соединения</string>
    <string name="mdm_require_tls_desc">IMAP и SMTP без SSL или STARTTLS не подключаются.</string>
    <string name="mdm_trusted_ca_pem_title">Корневые сертификаты организации (PEM)</string>
    <string name="mdm_trusted_ca_pem_desc">Один или несколько сертификатов ЦС в формате PEM; серверам, подписанным ими, приложение доверяет.</string>
    <string name="mdm_allow_user_cert_trust_title">Разрешить пользователю доверять сертификатам</string>
    <string name="mdm_allow_user_cert_trust_desc">Выключено — нельзя загрузить сертификат ЦС, вручную доверять сертификату сервера и использовать сертификаты из устройства; действуют только системные и сертификаты организации.</string>
    <string name="mdm_block_device_contacts_title">Запретить перенос контактов в устройство</string>
    <string name="mdm_block_device_contacts_desc">Без загрузки из «Контактов» устройства и выгрузки в них.</string>
    <string name="mdm_block_device_calendar_title">Запретить перенос встреч в устройство</string>
    <string name="mdm_block_device_calendar_desc">Встречи не добавляются в «Календарь» устройства.</string>
</resources>
