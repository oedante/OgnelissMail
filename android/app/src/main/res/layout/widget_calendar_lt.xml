<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано tool/dev/widget_themes.py — не править вручную. -->
<!-- Виджет «Календарь» (CalendarWidget): День · Неделя · Месяц · Мой день.
     Шапка — период (нажатие — сегодня) и стрелки; ниже переключатель вида;
     содержимое строит код: День — встречи дня карточкой; Неделя — полоса из
     7 дней и встречи недели по дням; Месяц — сетка 7 × 5–6 с цветными
     точками встреч; Мой день (18.11.2026, просьба владельца: «чтобы
     отдельный виджет не показывать») — доска «Предстоит · В работе ·
     Готово», как в виджете «Мой день». Нажатие на день недели или месяца —
     этот день. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    style="@style/WidgetRootLt">
    <LinearLayout style="@style/WidgetHeaderLt">
        <LinearLayout
            android:id="@+id/cal_head"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/cal_title"
                    style="@style/WidgetTitleLt"
                    android:text="@string/widget_cal_label" />
                <TextView
                    android:id="@+id/cal_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="20dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/widget_badge_bg_lt"
                    android:textColor="@color/widget_on_accent_lt"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/cal_sub"
                style="@style/WidgetSubtitleLt"
                android:visibility="gone" />
        </LinearLayout>
        <ImageView
            android:id="@+id/cal_prev"
            style="@style/WidgetNavButtonLt"
            android:src="@drawable/widget_ic_prev_lt"
            android:contentDescription="@string/widget_prev" />
        <ImageView
            android:id="@+id/cal_next"
            style="@style/WidgetNavButtonLt"
            android:src="@drawable/widget_ic_next_lt"
            android:contentDescription="@string/widget_next" />
        <ImageView
            android:id="@+id/cal_action"
            style="@style/WidgetHeadButtonLt"
            android:src="@drawable/widget_ic_add_lt"
            android:contentDescription="@string/widget_cal_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:padding="3dp"
        android:background="@drawable/widget_tabs_bg_lt">
        <TextView android:id="@+id/cal_tab0" style="@style/WidgetTabLt" android:text="@string/widget_cal_day" />
        <TextView android:id="@+id/cal_tab1" style="@style/WidgetTabLt" android:text="@string/widget_cal_week" />
        <TextView android:id="@+id/cal_tab2" style="@style/WidgetTabLt" android:text="@string/widget_cal_month" />
        <TextView android:id="@+id/cal_tab3" style="@style/WidgetTabLt" android:text="@string/widget_myday_label" />
    </LinearLayout>

    <!-- «Подключиться»: идущая или ближайшая (в 15 минутах) онлайн-встреча. -->
    <TextView
        android:id="@+id/cal_join"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/widget_badge_bg_lt"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_on_accent_lt"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Неделя: семь дней. -->
    <LinearLayout
        android:id="@+id/cal_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Месяц: дни недели и 5–6 строк (код). -->
    <LinearLayout
        android:id="@+id/cal_month"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Месяц и встречи выбранного дня (1.6.49, когда хватает высоты):
         сетка постоянной высоты, под ней — карточка cal_list. -->
    <LinearLayout
        android:id="@+id/cal_month_fixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Мой день: три колонки, как в widget_my_day_board (те же id — дела
         добавляет WidgetUi.fillBoard). -->
    <LinearLayout
        android:id="@+id/cal_board"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:id="@+id/board_c1"
        android:background="@drawable/widget_card_bg_lt">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/board_c1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
            <TextView
                android:id="@+id/board_c1_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/board_c1_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:id="@+id/board_c2"
        android:background="@drawable/widget_card_bg_lt">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/board_c2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
            <TextView
                android:id="@+id/board_c2_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/board_c2_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:id="@+id/board_c3"
        android:background="@drawable/widget_card_bg_lt">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/board_c3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
            <TextView
                android:id="@+id/board_c3_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/widget_sub_lt"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/board_c3_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
    </LinearLayout>

    <!-- День и неделя (и месяц со встречами дня): встречи карточкой. -->
    <LinearLayout
        android:id="@+id/cal_list"
        style="@style/WidgetCardLt" />
</LinearLayout>
