# «Будильник» Ogneliss Mail для iPhone (server/push-relay). Файл .env рядом с
# docker-compose.push.yml; права 600. Ключ .p8 — в каталоге keys/ (в
# контейнере — /keys). Подробно — README.md.

# Team ID учётной записи Apple Developer (10 символов, правый верхний угол
# developer.apple.com или Membership details).
APNS_TEAM_ID=

# Ключ APNs окружения Production (TestFlight и App Store): Key ID и путь к
# файлу AuthKey_<KEYID>.p8 внутри контейнера.
APNS_KEY_ID=
APNS_KEY_FILE=/keys/AuthKey_XXXXXXXXXX.p8

# Ключ Sandbox — для сборок из Xcode. Не нужен, если проверяете через
# TestFlight или если ключ Production создан «для обоих окружений».
#APNS_SANDBOX_KEY_ID=
#APNS_SANDBOX_KEY_FILE=/keys/AuthKey_YYYYYYYYYY.p8

# Bundle ID приложения.
APNS_TOPIC=com.ogneliss.mail

# Ключ приложения (заголовок x-api-key). Установщик берёт его из .env
# OAuth-прокси (PROXY_API_KEY) — это тот же OAUTH_PROXY_KEY, с которым собрано
# приложение. Пусто — регистрация без ключа.
PUSH_API_KEY=

# Внешний адрес службы (его же знает приложение: PUSH_RELAY_URL в сборке,
# по умолчанию https://www.ogneliss.ru/push) и путь (location в nginx).
PUBLIC_URL=https://www.ogneliss.ru/push
BASE_PATH=/push

# Тихие сигналы — не чаще, чем раз в столько минут (Apple: 2–3 в час).
MIN_SILENT_MINUTES=20

# Токен без обновления регистрации дольше стольких дней удаляется.
EXPIRE_DAYS=30
